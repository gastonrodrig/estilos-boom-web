
# ============================================================
# ESTILOS BOOM WEB — Variables de entorno
# ============================================================
# Copia este archivo como .env y completa los valores:
#   cp .env.example .env
# ============================================================

# ------------------------------
# URLs del Backend (NestJS)
# ------------------------------

# PRODUCCIÓN (deploy en Vercel / Cloud Run — no cambiar)
NEXT_PUBLIC_BASE_URL_PROD=https://estilos-boom-api-64516230398.europe-west1.run.app/api/v1

# DESARROLLO local → cambia el puerto si tu backend corre en otro
# Ejemplos:
#   NEXT_PUBLIC_BASE_URL_DEV=http://localhost:3000/api/v1
#   NEXT_PUBLIC_BASE_URL_DEV=http://localhost:3001/api/v1
#   NEXT_PUBLIC_BASE_URL_DEV=http://localhost:3002/api/v1  ← (default del proyecto)
NEXT_PUBLIC_BASE_URL_DEV=http://localhost:3002/api/v1

# ------------------------------
# Base de datos (MongoDB)
# ------------------------------
# Pide las credenciales al líder del proyecto
DATABASE_URL=

# ------------------------------
# Firebase (Auth + Storage)
# ------------------------------
# Pide los valores al líder del proyecto o en Firebase Console
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------
# Mercado Pago
# ------------------------------
NEXT_PUBLIC_MP_PUBLIC_KEY=
